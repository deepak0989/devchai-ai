# DevChat AI backend environment variables
# Copy this file to .env and fill in real values.

# Port the backend listens on
PORT=5000

# Supabase project settings (https://supabase.com/dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Service role key - SERVER SIDE ONLY, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Anon (publishable) key - used only for reference; the frontend talks to this backend
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# OpenRouter API key (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173
