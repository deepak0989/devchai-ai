# DevChat AI frontend environment variables
# Copy this file to .env and adjust if needed.

# API base URL. Leave as /api when running the Vite dev proxy (vite.config.ts).
VITE_API_BASE_URL=/api

# Supabase project settings (public values - safe for the browser)
# https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY